**/target/
# Local scratch assets at the repo root only; game assets under examples/ are tracked.
/assets/
# Player save files written while running the examples.
/examples/*/saves/

__pycache__/
# JavaScript dependencies, e.g. the docs site under docs/.
node_modules/

# Built from the grammar by `tree-sitter build --wasm`; the docs carry the copy that ships.
/editors/tree-sitter-story/tree-sitter-story.wasm
